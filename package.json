{
  "name": "skiwithme",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/embed.mjs",
    "build:assets": "vite build && node tools/embed.mjs --none",
    "test": "vitest run",
    "lint": "eslint .",
    "smoke": "node tests/smoke/smoke.mjs && node tests/smoke/start.mjs && node tests/smoke/freetier.mjs",
    "deploy": "npm run build && wrangler deploy",
    "worker:dev": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "globals": "16.5.0",
    "playwright": "1.64.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.162.0"
  }
}
