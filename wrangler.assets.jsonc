// Used by the GitHub deploy: the app and map data are uploaded as static assets
// (no 3 MB limit), and the Worker only handles /api/* (group rooms).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weski",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GROUPS", "class_name": "GroupRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GroupRoom"] }],
  "observability": { "enabled": true }
}
