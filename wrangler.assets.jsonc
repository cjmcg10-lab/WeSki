// Used by the GitHub deploy: the app and map data are uploaded as static assets
// (no 3 MB limit), and the Worker only handles /api/* (group rooms).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skiwithme",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // The app's own address (builtbyroger.app is in the owner's Cloudflare account). The workers.dev address keeps working.
  "routes": [{ "pattern": "skiwithme.builtbyroger.app", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // "/data/*": map files of resorts kept in R2 (public/data/r2.json) are served by the Worker from MAPS;
    // the rest pass straight through to the static files
    "run_worker_first": ["/api/*", "/data/*"]
  },
  // Resort map files (docs/ADDING_MOUNTAINS.md, "Map storage"). Free allowance: 10 GB, 1M writes, 10M reads a month.
  "r2_buckets": [{ "binding": "MAPS", "bucket_name": "skiwithme-maps" }],
  "durable_objects": {
    "bindings": [
      { "name": "GROUPS", "class_name": "GroupRoom" },
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      { "name": "RESORTLOG", "class_name": "ResortLog" },
      { "name": "FORECASTHIST", "class_name": "ForecastHistory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GroupRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts", "ResortLog"] },
    { "tag": "v3", "new_sqlite_classes": ["ForecastHistory"] }
  ],
  // Launch switches. PAYWALL "on" makes groups (creating), directions and the 7-day forecast need a pass.
  // Secrets (set by the owner in the Cloudflare dashboard, never in this file): RESEND_API_KEY,
  // PADDLE_WEBHOOK_SECRET. See docs/PAID_TIER.md.
  "vars": {
    "PAYWALL": "off",
    "WEATHER": "open-meteo",
    "MAIL_FROM": "SkiWithMe <signin@builtbyroger.app>",
    "PADDLE_ENV": "sandbox",
    "PADDLE_CLIENT_TOKEN": "test_03c17e15405c60d04760a656641",
    "PADDLE_PRICES": "{\"pri_01m7xyhm3habdpnghh36ah1etv\":\"day\",\"pri_01m7xyk6z28t41kfe9d1n0qmqt\":\"week\",\"pri_01m7xyme122wvrre3pq6b8nawf\":\"season\",\"pri_01m7xyn989mnvsga49aqcd5729\":\"crew\"}"
  },
  // Scheduled job: every 5 minutes one step of reading MeteoSwiss ensemble files for Swiss resorts (issue #57,
  // worker/meteoswiss.js). Most steps find nothing to do; a new run takes about 13 steps every 6 hours.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
