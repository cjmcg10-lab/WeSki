{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skiwithme",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": false }],
  "durable_objects": {
    "bindings": [
      { "name": "GROUPS", "class_name": "GroupRoom" },
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      { "name": "RESORTLOG", "class_name": "ResortLog" },
      { "name": "FORECASTHIST", "class_name": "ForecastHistory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GroupRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts", "ResortLog"] },
    { "tag": "v3", "new_sqlite_classes": ["ForecastHistory"] }
  ],
  // Launch switches. PAYWALL "on" makes creating groups, directions, the full Forecast, saved days and offline downloads need a pass.
  // Secrets (set by the owner in the Cloudflare dashboard, never in this file): RESEND_API_KEY,
  // PADDLE_WEBHOOK_SECRET. See docs/PAID_TIER.md.
  "vars": {
    "PAYWALL": "on",
    "WEATHER": "open-meteo",
    "MAIL_FROM": "",
    "PADDLE_ENV": "sandbox",
    "PADDLE_CLIENT_TOKEN": "",
    "REPORT_DIGEST_TO": "hello@builtbyroger.app",
    "PADDLE_PRICES": "{}"
  },
  // Scheduled job: every 5 minutes one step of reading MeteoSwiss ensemble files for Swiss resorts (issue #57,
  // worker/meteoswiss.js). Most steps find nothing to do; a new run takes about 13 steps every 6 hours.
  // The daily report email (worker/digest.js, docs/MAP_REPORTS.md) runs at 11:23 UTC (6:23 in Connecticut in winter):
  // DIGEST_CRON in worker/digest.js must match the second entry.
  "triggers": { "crons": ["*/5 * * * *", "23 11 * * *"] },
  // The report email is sent through Resend from MAIL_FROM to REPORT_DIGEST_TO, with the sign-in mail account
  // (RESEND_API_KEY secret). Without the key or MAIL_FROM it sends nothing; it never sends on days without new reports.
  "observability": { "enabled": true }
}
