{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skiwithme",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": false }],
  "durable_objects": {
    "bindings": [
      { "name": "GROUPS", "class_name": "GroupRoom" },
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      { "name": "RESORTLOG", "class_name": "ResortLog" },
      { "name": "FORECASTHIST", "class_name": "ForecastHistory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GroupRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts", "ResortLog"] },
    { "tag": "v3", "new_sqlite_classes": ["ForecastHistory"] }
  ],
  // Launch switches. PAYWALL "on" makes groups (creating), directions and the 7-day forecast need a pass.
  // Secrets (set by the owner in the Cloudflare dashboard, never in this file): RESEND_API_KEY,
  // PADDLE_WEBHOOK_SECRET. See docs/PAID_TIER.md.
  "vars": {
    "PAYWALL": "off",
    "WEATHER": "open-meteo",
    "MAIL_FROM": "",
    "PADDLE_ENV": "sandbox",
    "PADDLE_CLIENT_TOKEN": "",
    "REPORT_DIGEST_TO": "hello@builtbyroger.app",
    "REPORT_DIGEST_FROM": "reports@builtbyroger.app",
    "PADDLE_PRICES": "{}"
  },
  // Daily email of new map-mistake reports to the owner (worker/digest.js, docs/MAP_REPORTS.md), 11:23 UTC (6:23 in
  // Connecticut in winter). It sends nothing until the REPORT_MAIL binding below is switched on, and nothing on days
  // without new reports.
  "triggers": { "crons": ["23 11 * * *"] },
  // Cloudflare's own email sending. Switch on (remove the // on the next line) only after the owner has enabled Email
  // Routing on builtbyroger.app and verified the inbox (docs/MAP_REPORTS.md). No destination is fixed here, so the
  // binding may send to any address verified in the account; the Worker sends only to REPORT_DIGEST_TO.
  // "send_email": [{ "name": "REPORT_MAIL" }],
  "observability": { "enabled": true }
}
